{
  "name": "breadcrumb",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first AI learning companion: make learning visible, memorable, and anxiety-free.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check . && node scripts/check-file-length.mjs",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^5.9.0",
    "zod": "4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": "biome check --write --no-errors-on-unmatched"
  }
}
