# Copy to .env and fill in. Never commit .env.
# Used by development/testing pipelines (LLM-as-judge, simulated users), NOT by the product itself.
DEEPSEEK_API_KEY=sk-your-key-here

# Ed25519 private key that signs research tasks (the matching public key is compiled into
# packages/feature-research). Needed only when issuing a task at build time; the product
# never reads it, and users never need one.
RESEARCH_SIGNING_PRIVATE_KEY=
