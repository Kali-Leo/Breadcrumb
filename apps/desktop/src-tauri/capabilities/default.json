{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://127.0.0.1:*/*" }]
    },
    "sql:allow-execute",
    "sql:allow-select",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://[\\:\\:1]:*/*" }
      ]
    }
  ]
}
