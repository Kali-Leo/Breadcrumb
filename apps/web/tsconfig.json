{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@desktop/*": ["../desktop/src/*"],
      "@tauri-apps/plugin-sql": ["./src/shims/tauri-sql.ts"],
      "@tauri-apps/api/core": ["./src/shims/tauri-core.ts"],
      "@tauri-apps/plugin-http": ["./src/shims/tauri-http.ts"],
      "@tauri-apps/plugin-opener": ["./src/shims/tauri-opener.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
