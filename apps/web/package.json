{
  "name": "@breadcrumb/web",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.1.0",
  "description": "Browser edition: the same app, running with no install. SQLite compiles to WebAssembly and lives in the browser's own storage; the four Tauri modules are aliased to browser implementations, so the application code is shared verbatim with the desktop build.",
  "type": "module",
  "scripts": {
    "predev": "node src/shims/embedding/copy-ort-assets.mjs",
    "dev": "vite",
    "prebuild": "node src/shims/embedding/copy-ort-assets.mjs",
    "build": "vite build",
    "postbuild": "node ../../scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@breadcrumb/core-db": "workspace:*",
    "@huggingface/transformers": "4.2.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "d3-hierarchy": "^3.1.2",
    "i18next": "^26.4.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "pixi.js": "^8.19.0",
    "react": "^19.1.0",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.12",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "ts-fsrs": "^5.2.1",
    "unified": "^11.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.0"
  }
}
