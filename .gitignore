# ===== dependencies =====
node_modules/
.pnpm-store/

# ===== secrets & local env =====
.env
.env.*
!.env.example
# Key material of any shape, so a stray file cannot be committed by habit.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json

# ===== build & generated outputs =====
dist/
target/
*.tsbuildinfo
apps/desktop/src-tauri/gen/
scripts/canonical/out/
coverage/

# ===== local data & logs =====
*.log
*.db
*.sqlite
*.sqlite3
# SQLite's sidecar files hold rows that have not been checkpointed into the main file yet,
# so *.db alone is not enough to keep a test database out of the repo.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
# Crash and profiling dumps carry heap contents and absolute paths.
*.heapsnapshot
*.cpuprofile
# Signing and packaging material.
*.keystore
*.jks
*.crt
*.cer
packages/simlab/artifacts/

# ===== editor / OS =====
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# ===== internal working layer (AI rules, memory, process docs — not product parts) =====
CLAUDE.md
.claude/
docs/
specs/

# Language-pack build inputs: hundreds of megabytes of upstream dictionary dumps.
scripts/language-packs/.cache/
